<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 所有页面的转场动画：淡入淡出 + 轻微缩放/位移，系统默认的那套不再使用 -->
    <style name="BukaWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/page_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/page_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/page_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/page_close_exit</item>
        <item name="android:windowEnterAnimation">@anim/page_open_enter</item>
        <item name="android:windowExitAnimation">@anim/page_close_exit</item>
    </style>

    <!-- 自定义对话框窗口：透明背景、可更窄、无系统动画（动效自己写） -->
    <style name="BukaDialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">@color/primary</item>
    </style>

    <!-- 全应用按钮统一成对话框那套外观：覆盖 Material 的两个内置样式，
         这样各处 MaterialButton 不用逐个改布局 -->
    <style name="Widget.MaterialComponents.Button.OutlinedButton"
        parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">#26FFFFFF</item>
        <item name="strokeColor">#33FFFFFF</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <!-- 覆盖同名样式时不能再把自身当父样式（会形成资源循环），所以父样式取
         基础 Button，再用属性还原成「文字按钮」的样子 -->
    <style name="Widget.MaterialComponents.Button.TextButton"
        parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>
</resources>
